DEBUG=True
SECRET_KEY=generate-your-own-random-key-at-least-50-characters-long
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# py_logger (logger/logger.py) -- DEBUG locally for full detail, one file
# per day under backend/log/. LOG_FUNCTIONS=1 also logs every @error_logger
# call's entry/exit/timing (verbose -- leave off unless actively debugging).
LOG_LEVEL=DEBUG
LOG_FUNCTIONS=0
