# Used by docker-compose for the production-style stack (backend + nginx).
# Copy to `.env` on the deploy server (or let GitHub Actions write it from
# the `production` Environment secrets -- see .github/workflows/deploy.yml).
# For plain local development without Docker, see backend/.env.example and
# frontend/.env.example instead (main.py / `py main.py` uses those).

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=veles.settings.prod

# Absolute path (4 slashes) so it lands on the `backend_db` volume, not the
# container's ephemeral filesystem.
DATABASE_URL=sqlite:////app/data/db.sqlite3

ALLOWED_HOSTS=example.com,www.example.com
# Not actually load-bearing once nginx puts frontend+backend on one origin;
# kept as a safety net.
CORS_ALLOWED_ORIGINS=https://example.com

# py_logger (backend/logger/logger.py) -- quieter than local dev by default;
# one file per day on the backend_logs volume (/app/log) plus console
# (captured by `docker compose logs`). LOG_FUNCTIONS=1 is verbose, leave off
# in production.
LOG_LEVEL=INFO
LOG_FUNCTIONS=0

# Public but domain-restricted in the Yandex console. Register at
# https://yandex.ru/maps-api/console -- product "JavaScript API и HTTP
# Геокодер" (see docs/yandex-maps.md). Baked into the frontend bundle at
# Docker build time (see frontend/Dockerfile's ARG), not read at container
# runtime.
VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key-here

# Uncomment when migrating off SQLite (see the commented `postgres` service
# in docker-compose.yml):
# POSTGRES_DB=veles
# POSTGRES_USER=veles
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://veles:change-me@postgres:5432/veles
